[debug] [2026-09-10T21:50:49.276Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/kwetu-park/rulesets {"name":"projects/kwetu-park/rulesets/68869ecd-700e-48d1-9b2e-f27caa0dc29a","source":{"files":[{"content":"rules_version = '2';\n\n// Règles de départ pour Kwetu Park.\n// Elles sont prévues pour remplacer le mode test avant une mise en production.\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(uid) {\n      return signedIn() && request.auth.uid == uid;\n    }\n\n    function activeManager() {\n      return signedIn()\n          && exists(/databases/$(database)/documents/managers/$(request.auth.uid))\n          && get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.active != false;\n    }\n\n    function activeAdministrator() {\n      return signedIn()\n          && exists(/databases/$(database)/documents/administrators/$(request.auth.uid))\n          && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.active != false;\n    }\n\n    function staff() {\n      return activeManager() || activeAdministrator();\n    }\n\n    match /users/{userId} {\n      allow create: if isOwner(userId)\n          && request.resource.data.role == 'driver';\n      allow get: if isOwner(userId) || activeAdministrator();\n      allow list: if activeAdministrator();\n      allow update: if activeAdministrator()\n          || (isOwner(userId)\n              && (request.resource.data.role == resource.data.role || staff()));\n      allow delete: if activeAdministrator();\n    }\n\n    // Ces collections sont créées par l'administrateur. Un utilisateur ne\n    // peut jamais s'accorder lui-même un rôle supérieur.\n    match /managers/{userId} {\n      allow get: if isOwner(userId) || activeAdministrator();\n      allow list: if activeAdministrator();\n      allow update: if activeAdministrator()\n          || (isOwner(userId)\n              && request.resource.data.diff(resource.data).affectedKeys()\n                  .hasOnly(['lastLoginAt']));\n      allow create, delete: if activeAdministrator();\n    }\n\n    match /administrators/{userId} {\n      allow get: if isOwner(userId) || activeAdministrator();\n      allow list: if activeAdministrator();\n      allow update: if activeAdministrator()\n          || (isOwner(userId)\n              && request.resource.data.diff(resource.data).affectedKeys()\n                  .hasOnly(['lastLoginAt']));\n      allow create, delete: if activeAdministrator();\n    }\n\n    match /parking_spots/{spotId} {\n      allow read: if signedIn();\n      allow create, delete: if staff();\n      allow update: if staff()\n          || (signedIn()\n              && resource.data.status == 'available'\n              && request.resource.data.status == 'reserved'\n              && request.resource.data.reservedBy == request.auth.uid\n              && request.resource.data.diff(resource.data).affectedKeys()\n                  .hasOnly(['status', 'reservationId', 'reservedBy', 'updatedAt']))\n          || (signedIn()\n              && resource.data.status == 'reserved'\n              && resource.data.reservedBy == request.auth.uid\n              && request.resource.data.status == 'available'\n              && request.resource.data.diff(resource.data).affectedKeys()\n                  .hasOnly(['status', 'reservationId', 'reservedBy', 'updatedAt']));\n    }\n\n    match /reservations/{reservationId} {\n      allow create: if signedIn()\n          && request.resource.data.userId == request.auth.uid;\n      allow get, list: if signedIn()\n          && (resource.data.userId == request.auth.uid || staff());\n      // Lors de l'intégration Mobile Money réelle, ce droit de paiement sera\n      // remplacé par une Cloud Function ou un webhook vérifié.\n      allow update: if signedIn()\n          && (resource.data.userId == request.auth.uid || staff());\n      allow delete: if activeAdministrator();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-10T21:51:16.365535Z","metadata":{"services":["cloud.firestore"]}}
