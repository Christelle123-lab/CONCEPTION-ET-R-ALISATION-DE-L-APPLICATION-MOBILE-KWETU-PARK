[debug] [2026-09-11T21:25:11.616Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/kwetu-park/rulesets {"name":"projects/kwetu-park/rulesets/4f8a2c1a-ef66-4df0-bb74-74d854cfffd8","source":{"files":[{"content":"rules_version = '2';\n\n// Règles de départ pour Kwetu Park.\n// Elles sont prévues pour remplacer le mode test avant une mise en production.\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(uid) {\n      return signedIn() && request.auth.uid == uid;\n    }\n\n    function activeManager() {\n      return signedIn()\n          && exists(/databases/$(database)/documents/managers/$(request.auth.uid))\n          && get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.active != false;\n    }\n\n    function activeAdministrator() {\n      return signedIn()\n          && exists(/databases/$(database)/documents/administrators/$(request.auth.uid))\n          && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.active != false;\n    }\n\n    // Compatibilité avec les comptes du personnel créés directement dans\n    // users/{uid} par l'administrateur depuis Firebase Console. Un conducteur\n    // ne peut pas s'attribuer ce rôle lui-même : les règles de users ci-dessous\n    // interdisent toute élévation de rôle côté client.\n    function commonManagerRole() {\n      return signedIn()\n          && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n          && (\n            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'\n            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gestionnaire'\n          );\n    }\n\n    function commonAdministratorRole() {\n      return signedIn()\n          && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n          && (\n            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrator'\n            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrateur'\n            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'\n          );\n    }\n\n    function staff() {\n      return activeManager()\n          || activeAdministrator()\n          || commonManagerRole()\n          || commonAdministratorRole();\n    }\n\n    function administrator() {\n      return activeAdministrator() || commonAdministratorRole();\n    }\n\n    function isManagerRole(value) {\n      return value == 'manager' || value == 'gestionnaire';\n    }\n\n    function isAdministratorRole(value) {\n      return value == 'administrator'\n          || value == 'administrateur'\n          || value == 'admin';\n    }\n\n    function canKeepOrSyncOwnRole(userId) {\n      return isOwner(userId)\n          && (\n            request.resource.data.role == resource.data.role\n            || ((activeManager() || commonManagerRole())\n                && isManagerRole(request.resource.data.role))\n            || ((activeAdministrator() || commonAdministratorRole())\n                && isAdministratorRole(request.resource.data.role))\n          );\n    }\n\n    match /users/{userId} {\n      allow create: if isOwner(userId)\n          && (request.resource.data.role == 'driver' || staff());\n      allow get: if isOwner(userId) || administrator();\n      allow list: if administrator();\n      allow update: if administrator() || canKeepOrSyncOwnRole(userId);\n      allow delete: if administrator();\n    }\n\n    // Ces collections sont créées par l'administrateur. Un utilisateur ne\n    // peut jamais s'accorder lui-même un rôle supérieur.\n    match /managers/{userId} {\n      allow get: if isOwner(userId) || administrator();\n      allow list: if administrator();\n      allow update: if administrator()\n          || (isOwner(userId)\n              && request.resource.data.diff(resource.data).affectedKeys()\n                  .hasOnly(['lastLoginAt']));\n      allow create, delete: if administrator();\n    }\n\n    match /administrators/{userId} {\n      allow get: if isOwner(userId) || administrator();\n      allow list: if administrator();\n      allow update: if administrator()\n          || (isOwner(userId)\n              && request.resource.data.diff(resource.data).affectedKeys()\n                  .hasOnly(['lastLoginAt']));\n      allow create, delete: if administrator();\n    }\n\n    match /parking_spots/{spotId} {\n      allow read: if signedIn();\n      allow create, delete: if staff();\n      allow update: if staff()\n          || (signedIn()\n              && resource.data.status == 'available'\n              && request.resource.data.status == 'reserved'\n              && request.resource.data.reservedBy == request.auth.uid\n              && request.resource.data.diff(resource.data).affectedKeys()\n                  .hasOnly(['status', 'reservationId', 'reservedBy', 'updatedAt']))\n          || (signedIn()\n              && resource.data.status == 'reserved'\n              && resource.data.reservedBy == request.auth.uid\n              && request.resource.data.status == 'available'\n              && request.resource.data.diff(resource.data).affectedKeys()\n                  .hasOnly(['status', 'reservationId', 'reservedBy', 'updatedAt']));\n    }\n\n    match /reservations/{reservationId} {\n      allow create: if signedIn()\n          && request.resource.data.userId == request.auth.uid;\n      allow get, list: if signedIn()\n          && (resource.data.userId == request.auth.uid || staff());\n      // Lors de l'intégration Mobile Money réelle, ce droit de paiement sera\n      // remplacé par une Cloud Function ou un webhook vérifié.\n      allow update: if signedIn()\n          && (resource.data.userId == request.auth.uid || staff());\n      allow delete: if administrator();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-11T21:25:10.874879Z","metadata":{"services":["cloud.firestore"]}}
